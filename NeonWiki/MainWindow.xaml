<Window x:Class="NeonWiki.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Neon Wiki v1.0" 
        Height="800" Width="1400"
        Background="#000000"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================================ -->
        <!-- HEADER / TOOLBAR -->
        <!-- ============================================ -->
        <Border Grid.Row="0" 
                Background="#001a1a" 
                BorderBrush="#00FFFF" 
                BorderThickness="0,0,0,2"
                Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo/Title -->
                <TextBlock Grid.Column="0" 
                          Text="🧠 NEON WIKI"
                          FontFamily="Consolas"
                          FontSize="20"
                          FontWeight="Bold"
                          Foreground="#00FFFF"
                          VerticalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#00FFFF" BlurRadius="15" ShadowDepth="0"/>
                    </TextBlock.Effect>
                </TextBlock>

                <!-- Toolbar Buttons -->
                <StackPanel Grid.Column="2" 
                           Orientation="Horizontal" 
                           HorizontalAlignment="Right">
                    
                    <Button Content="📁 Select Wiki Folder" 
                            Style="{StaticResource NeonButtonStyle}"
                            Click="SelectFolder_Click"
                            Margin="0,0,10,0"/>
                    
                    <Button Content="➕ New File" 
                            Style="{StaticResource NeonButtonStyle}"
                            Click="NewFile_Click"
                            Margin="0,0,10,0"/>
                    
                    <Button Content="💾 Save (Ctrl+S)" 
                            Style="{StaticResource NeonButtonStyle}"
                            Click="SaveCurrent_Click"
                            Margin="0,0,10,0"/>
                    
                    <Button Content="✖ Close Tab" 
                            Style="{StaticResource NeonButtonStyle}"
                            Click="CloseTab_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================ -->
        <!-- MAIN CONTENT AREA -->
        <!-- ============================================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ========== LEFT SIDEBAR: File Tree ========== -->
            <Border Grid.Column="0"
                    Background="#000000"
                    BorderBrush="#008080"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Sidebar Header -->
                    <Border Grid.Row="0"
                            Background="#001a1a"
                            BorderBrush="#00FFFF"
                            BorderThickness="0,0,0,1"
                            Padding="15,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0"
                                       Text="📁 WIKI FILES"
                                       FontFamily="Consolas"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#00FFFF"
                                       VerticalAlignment="Center"/>
                            
                            <Button Grid.Column="1"
                                    Content="🔄"
                                    Style="{StaticResource NeonButtonStyle}"
                                    Width="30"
                                    Height="30"
                                    Padding="0"
                                    Click="RefreshTreeView_Click"
                                    ToolTip="Actualizar árbol de directorios (F5)"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- TreeView -->
                    <ScrollViewer Grid.Row="1" 
                                  VerticalScrollBarVisibility="Auto"
                                  Background="#000000">
                        <TreeView x:Name="TreeViewFiles"
                                  Style="{StaticResource NeonTreeViewStyle}"
                                  SelectedItemChanged="TreeViewFiles_SelectedItemChanged"
                                  Padding="10">
                            <!-- Items se agregan dinámicamente -->
                        </TreeView>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ========== SPLITTER ========== -->
            <GridSplitter Grid.Column="1"
                          Width="3"
                          HorizontalAlignment="Stretch"
                          Background="#00FFFF"
                          ShowsPreview="True"/>

            <!-- ========== RIGHT CONTENT: Tabs ========== -->
            <Border Grid.Column="2" Background="#000000">
                <TabControl x:Name="TabControlMain"
                            Style="{StaticResource NeonTabControlStyle}"
                            Background="#000000">
                    <!-- Tabs se agregan dinámicamente -->
                </TabControl>
            </Border>
        </Grid>

        <!-- ============================================ -->
        <!-- STATUS BAR -->
        <!-- ============================================ -->
        <StatusBar Grid.Row="2" 
                   Style="{StaticResource NeonStatusBarStyle}"
                   Height="30">
            <StatusBarItem>
                <TextBlock x:Name="StatusBar" 
                          Text="⚡ NEON WIKI READY - Select a wiki folder to begin"
                          Foreground="#00FFFF"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
